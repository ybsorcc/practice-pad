# ==========================================================================
# .gitattributes — consistent line endings across machines/agents
# Usage: copy into the repo folder and RENAME to ".gitattributes"
# ==========================================================================

# Normalize all text files to LF in the repo; check out native on each OS.
* text=auto

# Windows-specific scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts/markup use LF.
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf

# Treat these as binary (no line-ending munging) if ever committed intentionally.
*.png binary
*.jpg binary
*.pdf binary
